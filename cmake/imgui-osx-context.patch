+// Cocoa callbacks can arrive between frames, when another editor (or no editor)
+// owns the current context. Always restore the caller's context on return.
+struct ImGui_ImplOSX_ContextScope
+{
+    ImGuiContext* previous;
+    explicit ImGui_ImplOSX_ContextScope(ImGuiContext* context)
+        : previous(ImGui::GetCurrentContext()) { ImGui::SetCurrentContext(context); }
+    ~ImGui_ImplOSX_ContextScope() { ImGui::SetCurrentContext(previous); }
+};
