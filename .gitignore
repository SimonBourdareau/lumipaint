# Dependencies, cloned by the build rather than vendored. Committing them would put
# three upstream projects in your history and make every one of their commits look
# like yours.
clap-src/
imgui/
imgui2/
rtmidi/

# Build output
obj/
build/
build-vst3/
build-macos/
build-vst3.log
*.clap
*.vst3
*.o
*.a
*.so
*.dll
*.dylib

# Tool output
.DS_Store
capture_*.ppm
capture_*.bmp
*.pyc
__pycache__/

# the assembled release folder - its contents are attached to a GitHub release,
# not committed
release/
*.zip
