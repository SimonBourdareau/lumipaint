/*
    The same eighteen items lumi_paint activates, and nothing else at all.

    probe_config showed six controls, so the keyboard and Dashboard are both fine and
    the fault is inside lumi_paint. This separates the two things it could be.

    Panel shows a full set of controls
        The activation list is fine, and something ELSE in lumi_paint takes the panel
        down - the cluster calls, the config writes, the reporting. Then I look there
        instead, and stop touching the list.

    Panel is empty
        One of the twelve items beyond ROLI's six is rejected, and rejection empties the
        whole panel rather than skipping the item. Then it is a bisect: I halve the
        list and we do it twice more.

    Two keys are lit so you can tell it loaded: green at the left, blue at the right.
*/

void initialise()
{
    setLocalConfigActiveState(0, true, true);     // midiStartChannel
    setLocalConfigActiveState(1, true, true);     // midiEndChannel
    setLocalConfigActiveState(2, true, true);     // midiUseMPE
    setLocalConfigActiveState(4, true, true);     // octave
    setLocalConfigActiveState(9, true, true);     // midiChannelRange
    setLocalConfigActiveState(40, true, true);    // MPEZone

    setLocalConfigActiveState(3, true, true);     // pitchBendRange
    setLocalConfigActiveState(5, true, true);     // transpose
    setLocalConfigActiveState(17, true, true);    // pianoMode

    setLocalConfigActiveState(10, true, true);    // velocitySensitivity
    setLocalConfigActiveState(11, true, true);    // glideSensitivity
    setLocalConfigActiveState(13, true, true);    // pressureSensitivity
    setLocalConfigActiveState(14, true, true);    // liftSensitivity
    setLocalConfigActiveState(15, true, true);    // fixedVelocity
    setLocalConfigActiveState(16, true, true);    // fixedVelocityValue

    setLocalConfigActiveState(30, true, true);    // xTrackingMode
    setLocalConfigActiveState(32, true, true);    // zTrackingMode
    setLocalConfigActiveState(36, true, true);    // brightness

    setLocalConfigItemRange(4, -4, 6);
    setLocalConfigItemRange(30, 1, 4);
    setLocalConfigItemRange(32, 1, 4);

    setLocalConfig(33, 1);                        // gammaCorrection, set not activated
}

void repaint()
{
    for (int k = 0; k < 24; k = k + 1)
    {
        fillPixel(0xFF101010, k, 0);
    }

    fillPixel(0xFF20C040, 0, 0);
    fillPixel(0xFF2060E0, 23, 0);
}
