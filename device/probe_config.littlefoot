/*
    The smallest program that should produce a settings panel.

    Nothing but the six items ROLI's own LUMI script activates, copied from
    StudioLightkeyScript, and one line of lighting so you can see it loaded. No colour
    table, no cluster code, no reporting, nothing else that could interfere.

    Load it and open Dashboard.

    Panel shows six controls
        The keyboard is fine and the fault is somewhere in lumi_paint.littlefoot -
        something it does elsewhere is taking the panel down, and it can be found by
        adding this program's contents back a piece at a time.

    Panel is empty
        The keyboard's own configuration is the problem, not the program. Factory reset
        in Dashboard, then load this again. If it is still empty after a reset, the
        fault is in Dashboard or the firmware and nothing in a Littlefoot program will
        change it.

    Either answer is worth more than another guess from me.
*/

void initialise()
{
    setLocalConfigActiveState(0, true, true);    // midiStartChannel
    setLocalConfigActiveState(1, true, true);    // midiEndChannel
    setLocalConfigActiveState(2, true, true);    // midiUseMPE
    setLocalConfigActiveState(4, true, true);    // octave
    setLocalConfigActiveState(9, true, true);    // midiChannelRange
    setLocalConfigActiveState(40, true, true);   // MPEZone

    setLocalConfigItemRange(4, -4, 6);
}

void repaint()
{
    for (int k = 0; k < 24; k = k + 1)
    {
        fillPixel(0xFF103010, k, 0);
    }

    fillPixel(0xFF20C040, 0, 0);
}
