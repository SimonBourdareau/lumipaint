// Answers two questions at once, separately for each block in a chain.
//
//   KEY 0  blinks WHITE about twice a second if the firmware is calling repaint() on
//          this block at frame rate. Frozen means this block never repaints on its
//          own, and anything drawn here only updates when a message arrives.
//
//   KEY 2  blinks GREEN as MIDI reaches this block - it toggles every 8 messages.
//          Dark and still means this block is receiving nothing.
//
//   KEY 4  RED while the block has seen at least one message since it started.
//
// Run it with the plugin connected and its background sweep running, on both units.
// Report each key separately for master and slave.

int numKeys;
int frameCount;
int midiCount;

void initialise() {
    numKeys = 24;
    frameCount = 0;
    midiCount = 0;
}

void handleMIDI(int byte0, int byte1, int byte2) {
    midiCount = midiCount + 1;
}

void repaint() {
    frameCount = frameCount + 1;

    for (int i = 0; i < numKeys; i = i + 1) {
        fillPixel(0xFF000000, i, 0);
    }

    if (((frameCount / 12) % 2) == 0) { fillPixel(0xFFFFFFFF, 0, 0); }
    if (((midiCount / 8) % 2) == 0) { fillPixel(0xFF00FF00, 2, 0); }
    if (midiCount > 0) { fillPixel(0xFFFF0000, 4, 0); }
}
